.profileContainer {
  display: flex;
  justify-content: right;
}

.profileIconContainer {
  position: relative;
  cursor: pointer;
}

.profileIconContainer:hover .dropdownContent {
  display: block;
}

.dropdownContent {
  display: none;
  position: absolute;
  right: 0;
  top: 100%;
  background-color: white;
  width: auto;
  border-radius: 8px;
  box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.2);
  z-index: 1000;
  padding: 10px 0;
}

.dropdownContent li {
  padding: 12px 16px;
  color: #333;

  /**Code added by Unnati on 18-10-2024
  *Reason-Added font size
  */
  /* font-size: 16px; */
  font-size: var(--page-content-font-size);
  /**End of code addition by Unnati on 18-10-2024
  *Reason-Added font size
  */
  border-bottom: 1px solid #f0f0f0;
  list-style-type: none;
}

.dropdownContent li:last-child {
  border-bottom: none;
}

.dropdownContent li:hover {
  background-color: white;
  cursor: pointer;
  font-weight: bolder;
}

.logoutButton {
  /**Code modified by Unnati on 27-11-2024
  *Reason-Modified color
  */
  color: black;
  /**End of code addition by Unnati on 27-11-2024
  *Reason-Modified color
  */
  text-decoration: none;
  font-weight: bold;
}

.logoutButton:hover {
  text-decoration: underline;
}
