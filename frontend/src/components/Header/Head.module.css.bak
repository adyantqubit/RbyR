/* @media (max-width: 500px) { */
@media (max-width: 530px) {
  .headerTop {
    padding-left: 0px;
  }

  .headerTopLeftMost {
    padding-left: 0px;
  }
  /* .middleRightContainer {
    width: 270px;
  } */

  .dropdownSearch {
    width: 30%;
  }
  .searchContainer {
    height: 35px;
  }

  .cartContainer {
    height: 35px;
  }
  /* .logo {
    height: 70px;
  } */
  .iconContainer {
    display: none;
  }
  .icons {
    padding-left: 0px;
    padding-right: 0px;
  }
  /* Addition by Om Shrivastava on 12-12-2024
  Reason : Add css for search  */
  .searchIconPhoneView{
    display: block;
  }
  .cancelIconContainerPhoneview{
    display: flex;
  }
 
  .middleRightContainer {
    display: none; /* Hide by default */
  }
  .middleRightContainerPhoneView{
    display: block;
    width: 430px;
  }
   /* End of addition by Om Shrivastava on 12-12-2024
  Reason : Add css for search */

  .searchIconContainerPhoneview {
    display: block; /* Show the search icon */
  }

  .col3Logo {
    display: block; /* Default for mobile until search is active */
  }

  .arrowBackIconContainerPhoneview {
    display: none; /* Hide back icon by default */
  }

  .allIconssContainers {
    display: flex; /* Show icons initially */
    align-items: center;
  }
  .wishlistAndcart{
  margin-left: 42%;}

  .headerBottom{
    display: none;
  }
  .drawer{
    display: flex;
    justify-content: center;
    align-items: center;
    width: 50px;
  }

}

