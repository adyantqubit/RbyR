@media (max-width: 753px) {
  .headerTopLeftMostLoggedIn {
    width: 90%;
  }
  
  .headerTopLeftMostLoggedOut {
    width: 70%;
  }
  /* Added by jhamman on 27-10-2024
Reason - added css to make responsive*/
  .headerTopLeftMost {
    /* width: 78%; */
  }

  .icons {
    width: 22%;
  }
  /* End of addition by jhamman on 27-10-2024
Reason -  added css to make responsive*/
  .dropdownSelect {
    padding: 8px;
    border: none;
    outline: none;
    font-size: 12px;
    width: 100%;
    height: 100%;
  }
  .headerTopLeftMost {
    display: flex;
  }
  .headerTop .icons {
    margin-left: 0%;
    width: auto;
  }
  /* .cartContainer .cart {
    display: block;
  } */
  .cartContainer .cartText {
    display: none;
  }
  .col9Search {
    display: flex;
    flex-direction: row;
  }
  .dropdownMenu {
    display: none;
  }
  .dropdownSearch {
    display: block;
  }
  .dropdownSearch.active .dropdownMenu {
    display: none;
  }
  .arrowIcon {
    transform: rotate(90deg);
  }
  .searchBarInput {
    width: 70%;
  }
  .productContainer {
    flex-direction: row;
    align-items: flex-start;
    padding: 8px;
  }

  .imageSearchSize {
    width: 60px;
    height: 60px;
    margin-right: 15px;
  }
  .filteredProduct div {
    padding: 5px;
  }
  .productInfo {
    flex-grow: 1;
  }

  .searchName {
    font-size: 12px;
  }

  .productDescription {
    font-size: 12px;
  }

  .productPrice {
    font-size: 12px;
    margin-left: auto;
    text-align: right;
  }

  /* Added by jhamman on 30-10-2024
  Reason - change the height of logo, search and cart*/
