  font-weight: 700;
}
.signIn:hover {
  color: var(--header-background-color-light);
}

.allCatBurger {
  color: var(--header-font-color-dark);
  display: flex;
  justify-content: space-between;
  width: 100%;
  height: 20px;
  padding-top: 3px;
}

.col3Category a {
  /* display: flex;  */
  display: block;
  align-items: center;
  padding: 10px;
  width: 100%;
}
/**Code modified by Unnati on 05-10-2024
*Reason-Modifed category css
*/
.col3Category {
  align-items: center;
  background-color: var(--page-color);
  flex: 0 0 11%;
  max-width: 11%;
  border-radius: 4px 4px 0 0;
  margin-right: 18px;
  display: flex;
}

.col3Category .allCatBurger .text,
.iconWrapper {
  height: 20px;
  padding-top: 3px;
}
/**End of code modification by Unnati on 05-10-2024
*Reason-Modifed category css
*/
.iconWrapper {
  size: 100px;
  align-items: center;
  /* margin-left: 30%; */
}
.brands {
  position: relative;
}
.productImage {
  width: 80px;
  height: 100px;
}
.brandDropdown {
  /* display: none; */
  position: absolute;
  left: 0;
  top: 100%;
  width: auto !important;
  height: auto !important;
  gap: 0 !important;
  background-color: #fff;
  box-shadow: 0 5px 10px rgba(0, 0, 0, 0.1);
  z-index: 1000;
  padding: 10px;
}
/* .brands:hover .brandDropdown {
  display: block;
} */

.brandDropdown li {
  display: flex !important;
  flex-direction: column;

  align-items: center;
  padding: 10px;
}
.brandDropdown li ul {
  display: grid;
  grid-template-rows: repeat(4, 1fr);
}

.brandDropdown li a {
  font-size: var(--page-content-font-size);
  color: #333;
  padding: 14px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.brandImage {
  width: 80px;
  height: 80px;
  object-fit: contain;
  margin-bottom: 5px;
}
.linkName {
  font-size: 14px;
  color: #333;
  width: 200px;
}
.brandName {
  font-size: 14px;
  color: #333;
  width: 100%;
}
.productContainer {
  display: flex;
  align-items: center;
  padding: 10px;
  border-bottom: 1px solid #ccc;
  transition: box-shadow 0.3s ease;
  align-items: flex-start;
}

.productContainer:hover {
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}
.noProductFound {
  display: flex;
  justify-content: center;
}
.imageSearchSize {
  width: 80px;
  height: 80px;
  object-fit: contain;
  margin-right: 20px;
}

.productInfo {
  flex-grow: 1;
  padding: 5px;
  /**Code added by Unnati on 18-10-2024
  *Reason-Added font size
  */
  font-size: var(--page-content-font-size);
  /**End of code addition by Unnati on 18-10-2024
  *Reason-Added font size
  */
}

.productInfo h3 {
  margin: 0;
  /* font-size: 18px; */
  color: var(--page-content-font-color);
}

.productInfo p {
  margin: 5px 0;
  /**Code added by Unnati on 18-10-2024
  *Reason-Added font size
  */
  font-size: var(--page-content-font-size);
  /**End of code addition by Unnati on 18-10-2024
  *Reason-Added font size
  */
  color: var(--page-content-title-font-color);
}
