    width: 75%;
  }

  .icons {
    width: 25%;
  } */

  .headerMiddle {
    padding: 0px;
  }

  .row {
    align-items: center;
  }
  .searchContainer {
    height: 35px;
  }

  .cartContainer {
    height: 35px;
  }

  .logo {
    height: 65px;
  }

  .middleRightContainer {
    width: 350px;
  }

  .dropdownSearch {
    width: 30%;
  }
 /* Addition by Om Shrivastava on 12-12-2024
  Reason : Add css for icons  */
