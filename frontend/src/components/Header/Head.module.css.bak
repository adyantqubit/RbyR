.header {
  position: relative;
  top: 0;
  left: 0;
  right: 0;
  background-color: white;

  box-shadow: 0 5px 10px rgba(0, 0, 0, 0.1);
  align-items: center;
  justify-content: space-between;
  z-index: 1000;
  font-size: 13px;
  color: var(--header-font-color-dark);
}
/* .header.scrolled {
  background-color: #fff; 
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
} */

