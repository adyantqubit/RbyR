  border-radius: 4px;
}
.signInContainer {
  display: flex;
  color: var(--page-color);
  align-items: center;
  gap: 8px;
}
.searchBar {
  padding-left: 2%;
  outline: none;

  /**Code added by Unnati on 18-10-2024
  *Reason-Added font size
  */
  /* font-size: 13px; */
  font-size: var(--page-content-font-size);
  /**End of code addition by Unnati on 18-10-2024
  *Reason-Added font size
  */
  background-color: #f4f6f800;
  /* border-radius: 4px; */
  width: 100%;
  height: 100%;
  padding-right: 40px;
  border: none;
  /* margin-top: 10px; */
}

.searchButton {
  width: 50px;
  position: absolute;
  right: 0;
  /**Code modified by Unnati on 13-10-2024
  *Reason-Changed button color
  */
  background-color: var(--button-color);
  border: none;
  cursor: pointer;
  padding: 0 10px;
  font-size: 16px;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--button-font-color);
  /**End of code modification by Unnati on 13-10-2024
  *Reason-Changed button color
  */
  font-weight: 1000;
}
.productCount {
  color: var(--page-content-subTitle-font-color);
  font-size: var(--page-content-subTitle-font-size);
  font-weight: 600;
  padding: 10px;
}
.dropdownSearch {
  display: flex;
  align-items: center;
  /* width: 30%; */
  width: 120px;
  border-right: 1px solid#ede8e8;
  color: black;
}
.selectCategory {
  border: none;
  outline: none;
  width: 100%;
  height: 100%;
  /**Code added by Unnati on 18-10-2024
  *Reason-Added font size
  */
  font-size: var(--page-content-font-size);
  /**End of code addition by Unnati on 18-10-2024
  *Reason-Added font size
  */
}
.selectCategoryValue {
  border: none;
  outline: none;
  margin-top: 10px;
  /**Code added by Unnati on 18-10-2024
  *Reason-Commented font size
  */
  /* font-size: var(--page-content-font-size); */
  /**End of code addition by Unnati on 18-10-2024
  *Reason-Commented font size
  */
}
.dropdownSelect {
  padding: 8px;
  border: none;
  outline: none;
  font-size: 13px;
  width: 100%;
}

.dropdownSelect option {
  height: 10px;
}

.dropdownSelect:focus {
  border-color: #007bff;
  outline: none;
}
.cartText {
