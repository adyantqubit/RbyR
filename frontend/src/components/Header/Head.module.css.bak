}

.navbar ul li ul {
  display: none;
  /* display: grid; */
  grid-template-columns: repeat(4, 1fr);
  position: absolute;
  left: 0;
  top: 100%;
  width: 100%;
  background-color: #fff;
  box-shadow: 0 5px 10px rgba(0, 0, 0, 0.1);
  z-index: 1000;
}
.navbar ul li .securityDropdown {
  display: none;
  /* display: grid; */
  /* grid-template-columns: repeat(4,1fr); */
  position: absolute;
  left: 0;
  top: 100%;
  width: 100%;
  background-color: #fff;
  box-shadow: 0 5px 10px rgba(0, 0, 0, 0.1);
  z-index: 1000;
}
.navbar ul li .helpDropdown {
  display: none;
  /* display: grid; */
  /* grid-template-columns: repeat(4,1fr); */
  position: absolute;
  left: 0;
  top: 100%;
  width: 100%;
  background-color: #fff;
  box-shadow: 0 5px 10px rgba(0, 0, 0, 0.1);
  z-index: 1000;
}
.navbar ul li ul:hover {
  display: none;
}
.homePage ul li .allCategories {
  display: block;
  position: absolute;
  left: 0;
  top: 100%;
  /* width: 100%; */
  background-color: #fff;
  box-shadow: 0 5px 10px rgba(0, 0, 0, 0.1);
  z-index: 1000;
}
.homePage ul li ul li:hover {
  background-color: var(--page-color);
}
.navbar ul li .allCategories li {
  width: 100%;
  border-top: 1px solid rgba(0, 0, 0, 0.1);
}

.navbar ul li:hover > ul {
  display: grid;
}
.navbar ul li:hover > .helpDropdown {
  display: block;
}
.navbar ul li .helpDropdown {
  width: 200px;
}
.navbar ul li:hover > .securityDropdown {
  display: block;
}
.navbar ul li:hover > .allCategories {
  display: block;
}
.navbar ul li ul li {
